# config.env — settings for ./fcvm (Firecracker + Alpine/Ubuntu microVM)
#
# Each setting uses the form VAR="${VAR:-default}" so it can be overridden two
# ways, without editing this file:
#     MEM_MIB=2048 VCPUS=4 ./fcvm run     # per-invocation, via the environment
# To change a default permanently, edit the value after :- below.
#
# This file is sourced by ./fcvm, so it is plain shell syntax.

# ---- Guest distro ----------------------------------------------------------
# DISTRO=alpine builds the rootfs from scratch (Alpine latest, via apk.static).
# DISTRO=ubuntu uses Firecracker's official Ubuntu image (squashfs -> ext4).
# The two images coexist under build/, so you can switch freely:
#     DISTRO=ubuntu ./fcvm build && DISTRO=ubuntu ./fcvm run
DISTRO="${DISTRO:-alpine}"
UBUNTU_RELEASE="${UBUNTU_RELEASE:-24.04}"   # only used when DISTRO=ubuntu

# ---- Guest (both distros) --------------------------------------------------
GUEST_HOSTNAME="${GUEST_HOSTNAME:-fcvm}"
ROOT_PASSWORD="${ROOT_PASSWORD:-alpine}"     # console autologin is passwordless; this is for ssh
# Public key injected into the guest's /root/.ssh/authorized_keys for key-based
# ssh. Leave empty (default) to auto-generate a dedicated fcvm key-pair on the
# first build (see SSH_KEY); set this to a .pub path to inject your own key.
SSH_PUBKEY="${SSH_PUBKEY:-}"
# Dedicated ssh key-pair, auto-generated on the first build when SSH_PUBKEY is
# empty. The private key stays here on the host and `fcvm ssh` authenticates
# with it; its public half is baked into the rootfs. Lives under build/, so
# `clean --all` regenerates it. Override to keep the key elsewhere (persistent).
SSH_KEY="${SSH_KEY:-$BUILD_DIR/fcvm_id_ed25519}"
# Floor for the ext4 image size. Alpine uses exactly this; Ubuntu grows beyond
# it automatically to fit its (~400 MiB) contents.
ROOTFS_SIZE_MIB="${ROOTFS_SIZE_MIB:-10240}"

# ---- Optional data disk ----------------------------------------------------
# A second virtio block device for the guest, appearing as /dev/vdb. It is
# opt-in via FLAGS (not env toggles); these settings only tune where/how big:
#   ./fcvm setup --data-disk    # create + ext4-format the image on the host
#   ./fcvm build --mount        # auto-mount /dev/vdb at DATA_DISK_MOUNT (fstab)
#   ./fcvm run                  # attaches /dev/vdb automatically if the image exists
#   ./fcvm up --data-disk --mount
# Keep DATA_DISK_PATH outside build/ if you want it to survive `clean --all`.
DATA_DISK_PATH="${DATA_DISK_PATH:-$BUILD_DIR/data.ext4}"  # image location
DATA_DISK_SIZE_MIB="${DATA_DISK_SIZE_MIB:-1024}"          # size used when creating it
DATA_DISK_MOUNT="${DATA_DISK_MOUNT:-/mnt/data}"           # in-guest mountpoint for --mount

# ---- Alpine guest (DISTRO=alpine) ------------------------------------------
# ALPINE_BRANCH: "latest-stable" always tracks the newest Alpine release.
# Pin to a series (e.g. "v3.23") for reproducible builds.
ALPINE_BRANCH="${ALPINE_BRANCH:-latest-stable}"
ALPINE_MIRROR="${ALPINE_MIRROR:-https://dl-cdn.alpinelinux.org/alpine}"
# Extra apk packages baked into the rootfs (alpine-base/openrc/openssh are
# always added by the builder). Space-separated.
ROOTFS_PACKAGES="${ROOTFS_PACKAGES:-util-linux chrony}"

# ---- Firecracker + kernel --------------------------------------------------
# FC_VERSION empty => auto-detect the latest GitHub release at setup time.
FC_VERSION="${FC_VERSION:-}"
# Guest kernel: Firecracker publishes microVM-tuned kernels (all virtio drivers
# built in, no initramfs needed). These two values pick one from that bucket.
FC_CI_VERSION="${FC_CI_VERSION:-v1.15}"
KERNEL_VERSION="${KERNEL_VERSION:-6.1.155}"

# ---- VM resources ----------------------------------------------------------
VCPUS="${VCPUS:-2}"
MEM_MIB="${MEM_MIB:-8192}"

# ---- Host networking (point-to-point /30 + NAT for guest internet) ---------
TAP_DEV="${TAP_DEV:-fc-tap0}"
HOST_IP="${HOST_IP:-172.16.0.1}"
GUEST_IP="${GUEST_IP:-172.16.0.2}"
NETMASK="${NETMASK:-255.255.255.252}"
GUEST_MAC="${GUEST_MAC:-06:00:AC:10:00:02}"
GUEST_DNS="${GUEST_DNS:-1.1.1.1}"
